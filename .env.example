# ─── Application ─────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Session ─────────────────────────────────────
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex')|0|console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string_minimum_32_chars

# ─── MongoDB ─────────────────────────────────────
# Local:  mongodb://localhost:27017/peopledesk
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/peopledesk?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/peopledesk

# ─── Admin Seed (used only by scripts/seed.js) ───
SEED_ADMIN_EMAIL=admin@peopledesk.com
SEED_ADMIN_PASSWORD=Admin@123!

# ─── Production only ─────────────────────────────
# CORS_ORIGIN=https://yourapp.onrender.com
